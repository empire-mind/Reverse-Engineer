{
  "name": "rea-workbench",
  "version": "0.2.0",
  "private": true,
  "description": "Persistent investigation workflows for the published REA CLI and MCP server.",
  "type": "module",
  "engines": {
    "node": "^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "rea": "rea",
    "rea:mcp": "rea mcp",
    "workbench": "node bin/workbench.mjs",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node --test test/*.integration.mjs",
    "workbench:mcp": "node bin/workbench-mcp.mjs",
    "memory:mcp": "node bin/memory-mcp.mjs",
    "deploy": "node bin/deploy.mjs",
    "package:plugin": "node scripts/package-plugin.mjs",
    "verify:plugin": "node scripts/verify-package.mjs",
    "test:plugin": "node scripts/plugin-smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "jsonc-parser": "3.3.1",
    "rea-agents": "6.5.0",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "license": "MIT"
}
